# ─────────────────────────────────────────────────────────────
# Environment configuration — copy to .env and fill in real values.
# NEVER commit real credentials. .env is git-ignored.
# ─────────────────────────────────────────────────────────────

# Database
# Local dev (SQLite, zero-config):     file:./dev.db
# Production (PostgreSQL, e.g. Supabase/Railway/Neon):
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
# NOTE: when switching to PostgreSQL, also change provider in prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Public site URL (no trailing slash) — used for canonical URLs, sitemap, emails
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth — admin session signing secret. Generate: openssl rand -base64 32
SESSION_SECRET="change-me-generate-a-long-random-string-min-32-chars"

# Seed admin account (used ONLY by `npm run db:seed` to create the first admin)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe!12345"
SEED_ADMIN_NAME="Site Admin"

# ── Business contact details (public, shown on the website) ──
# [PLACEHOLDER — REPLACE BEFORE LAUNCH]
NEXT_PUBLIC_BUSINESS_EMAIL=""
# Phone in display format, e.g. +91 98XXXXXXXX
NEXT_PUBLIC_BUSINESS_PHONE=""
# WhatsApp number in international format, digits only, e.g. 9198XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# ── Email notifications (SMTP) ──
# If unset, emails are skipped gracefully and logged to the server console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Where lead notification emails are sent (usually the business owner's inbox)
LEAD_NOTIFY_EMAIL=""
# From address shown to recipients, e.g. "Website Leads <no-reply@yourdomain.com>"
EMAIL_FROM=""

# ── Optional analytics (privacy-conscious, first-party) ──
# Set to "false" to disable first-party event tracking stored in the database.
NEXT_PUBLIC_ANALYTICS_ENABLED="true"
